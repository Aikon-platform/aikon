# install mode: local (just run the app) | dev (edit the code, live reload) | prod (deployment)
MODE=local

# lowercase name of the application
APP_NAME=aikon

# application language ("fr" or "en")
APP_LANG=en

# absolute path of the folder storing all app data (media files, api data). Created if missing. Defaults to <project>/data
DATA_DIR=

# modules to enable, comma-separated (region_extraction, similarity, vectorization)
INSTALLED_APPS=similarity,region_extraction

# geonames username (create yours on https://www.geonames.org/login)
GEONAMES_USER=aikon

# ------------------------------- ports --------------------------------------

FRONT_PORT=8000
API_PORT=5001
DB_PORT=5432
REDIS_PORT=6379
CANTALOUPE_PORT=8182
CANTALOUPE_PORT_HTTPS=8183
MONGODB_PORT=27017
AIIINOTATE_PORT=4444
MIRADOR_PORT=5555

# [prod] port of the nginx entrypoint container
NGINX_PORT=8080

# --------------------- credentials (blank = auto-generated) -----------------

#  ⚠️  also used as django admin password (with admin username)  ⚠️  
POSTGRES_PASSWORD=
POSTGRES_DB=aikon
POSTGRES_USER=admin
SECRET_KEY=

# ------------------------------ prod only -----------------------------------

# domain name of the deployed front, without scheme (e.g. aikon.enpc.fr)
PROD_URL=
# full URL of the deployed API (e.g. https://discover-api.enpc.fr)
PROD_API_URL=
# SMTP server domain
EMAIL_HOST=smtp.gmail.com
# email address sending alert emails
EMAIL_HOST_USER=
# app password for that email address
EMAIL_HOST_PASSWORD=
# footer logos (must match front/app/webapp/static/img/logo-*.png)
APP_LOGO=anr,ponts
HTTP_PROXY=
HTTPS_PROXY=
# host nginx: paths to the SSL certificate and key (e.g. /etc/letsencrypt/live/<domain>/fullchain.pem)
SSL_CERTIFICATE=
SSL_KEY=

# ----------------------- advanced -----------------------

MONGODB_DB=aikon_aiiinotate
AIIINOTATE_PAGE_SIZE=5000
AIIINOTATE_LOG_TARGET=stdout
AIIINOTATE_LOG_LEVEL=debug
NGINX_MAX_BODY_SIZE=500M
NGINX_TIMEOUT=300
