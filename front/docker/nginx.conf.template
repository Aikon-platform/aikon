# Substituted at container startup by the nginx image's native envsubst
# (values come from docker/.env). ${VAR} = substituted, $var = nginx runtime.

upstream django {
    server     web:8000;
    keepalive  32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name localhost ${PROD_URL};

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    keepalive_timeout           ${NGINX_TIMEOUT};
    proxy_connect_timeout       ${NGINX_TIMEOUT};
    proxy_send_timeout          ${NGINX_TIMEOUT};
    proxy_read_timeout          ${NGINX_TIMEOUT};
    send_timeout                ${NGINX_TIMEOUT};

    gzip on;
    gzip_static on;
    gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        proxy_pass              http://django;

        proxy_set_header        Host                 $host;
        proxy_set_header        X-Real-IP            $remote_addr;
        proxy_set_header        X-Forwarded-For      $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto    $scheme;
        proxy_set_header        X-Forwarded-Host     $host;
        proxy_set_header        X-NginX-Proxy        true;

        proxy_set_header        Upgrade              $http_upgrade;
        proxy_set_header        Connection           $connection_upgrade;

        proxy_http_version      1.1;
        proxy_redirect          off;
        proxy_pass_header       X-Accel-Buffering;
    }

    location /iiif/ {
        proxy_pass              http://cantaloupe:${CANTALOUPE_PORT}/iiif/;
        proxy_set_header        Host                 $host;
        proxy_set_header        X-Real-IP            $remote_addr;
        proxy_set_header        X-Forwarded-For      $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto    $scheme;
    }

    location /mirador/ {
        proxy_pass              http://mirador:${MIRADOR_PORT}/mirador/;
        proxy_http_version      1.1;
        proxy_pass_header       Set-Cookie;

        proxy_set_header        Upgrade           $http_upgrade;
        proxy_set_header        Connection        'upgrade';
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
    }

    location /aiiinotate/ {
        proxy_pass              http://aiiinotate:${AIIINOTATE_PORT}/;
        proxy_http_version      1.1;
        proxy_cache_bypass      $http_upgrade;
        proxy_set_header        Upgrade              $http_upgrade;
        proxy_set_header        Connection           $connection_upgrade;
        proxy_set_header        Host                 $host;
        proxy_set_header        X-Real-IP            $remote_addr;
        proxy_set_header        X-Forwarded-For      $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto    $scheme;

        proxy_read_timeout    60s;
        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
    }

    location /static/ {
        autoindex off;
        alias /staticfiles/;
    }

    location /media/ {
        autoindex off;
        alias /data/mediafiles/;
    }

    location /favicon.ico {
        alias /staticfiles/favicon.ico;
    }
}
